[Unit]
Description=Finance AI Streamlit App
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/finance-ai
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/opt/finance-ai/.env
ExecStart=/opt/finance-ai/venv/bin/streamlit run app.py --server.address 0.0.0.0 --server.port 8501 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
