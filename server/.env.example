# ==========================================
# 财务 AI 系统环境变量
# 用法：复制为 .env 后填入真实值
# ==========================================

# ---------- 智谱 AI ----------
ZHIPU_API_KEY=你的智谱APIKey

# ---------- 本地 PostgreSQL ----------
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=finance
PGUSER=finance
PGPASSWORD=改成你的数据库密码

# ---------- MCP（可选，服务器上默认关闭）----------
LOCAL_MCP=false

# ---------- 一次性数据迁移用：Supabase 连接池 ----------
# 取自 Supabase 控制台 Settings > Database > Connection string (Session pooler)
# 注意：这是"数据库密码"，不是 anon key / service_role key
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.你的项目ref
SUPABASE_DB_PASSWORD=你的Supabase数据库密码
